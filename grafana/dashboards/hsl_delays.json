{
  "uid": "hsl-delays",
  "title": "HSL real-time delays",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Average delay by line (seconds late, 5-min windows)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hsl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hsl-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, route AS metric, avg_delay_s AS value\nFROM line_delay_5min\nWHERE $__timeFilter(window_start)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Worst lines right now (last 15 min)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hsl-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hsl-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT route, max(line) AS line, round(avg(avg_delay_s)::numeric, 0) AS avg_delay_s,\n       max(p90_delay_s) AS p90_delay_s, sum(vehicles) AS vehicle_windows\nFROM line_delay_5min\nWHERE window_start > (SELECT max(window_start) FROM line_delay_5min) - interval '15 minutes'\nGROUP BY route ORDER BY avg_delay_s DESC LIMIT 10"
        }
      ]
    },
    {
      "id": 3,
      "title": "Events per minute processed",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hsl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hsl-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, sum(events) / 5.0 AS events_per_min\nFROM line_delay_5min\nWHERE $__timeFilter(window_start)\nGROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "title": "Seconds since last micro-batch",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hsl-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hsl-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM now() - max(processed_at)) AS seconds FROM pipeline_batches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Event-time lag of newest data (s)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hsl-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 9,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hsl-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT extract(epoch FROM now() - max(max_event_time)) AS seconds FROM pipeline_batches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Messages per second by status (producer)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "hsl-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hsl-prometheus"
          },
          "expr": "sum by (status) (rate(hsl_messages_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Dead-letter share (%)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "hsl-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hsl-prometheus"
          },
          "expr": "100 * sum(rate(hsl_messages_total{status=\"dead_letter\"}[5m])) / sum(rate(hsl_messages_total[5m]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Event lag p95 (s)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "hsl-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hsl-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hsl_event_lag_seconds_bucket[5m])))"
        }
      ]
    }
  ],
  "tags": [
    "hsl",
    "streaming"
  ]
}
